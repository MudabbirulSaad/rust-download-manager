{
  "name": "rust-download-manager",
  "private": true,
  "version": "0.2.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "extensions": "node scripts/build-extensions.mjs",
    "types": "node scripts/export-types.mjs",
    "types:check": "node scripts/export-types.mjs --check",
    "agent:validate": "node scripts/agent-workflow.mjs validate",
    "agent:ticket": "node scripts/agent-workflow.mjs ticket",
    "agent:doctor": "node scripts/agent-workflow.mjs doctor",
    "agent:check": "node scripts/agent-workflow.mjs check",
    "agent:handoff": "node scripts/agent-workflow.mjs handoff",
    "agent:test": "node --test tests/agent-workflow.test.mjs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
