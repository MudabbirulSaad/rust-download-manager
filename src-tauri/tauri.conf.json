{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Download Manager", "version": "0.2.2", "identifier": "org.rdm.desktop",
  "build": {"beforeDevCommand":"npm run dev","beforeBuildCommand":"npm run build","devUrl":"http://127.0.0.1:1420","frontendDist":"../web-dist"},
